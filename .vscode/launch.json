    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug driver tests (-v)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/internal/driver",
            "args": ["-test.v"],
            "env": {
                "CGO_CFLAGS": "-I/opt/homebrew/opt/z3/include",
                "CGO_LDFLAGS": "-L/opt/homebrew/opt/z3/lib",
                "GOTRACEBACK": "crash"
            }
        }
    ]
}